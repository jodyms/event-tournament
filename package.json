{
  "name": "kickzone-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@kickzone/web",
    "dev:web": "npm run dev --workspace=@kickzone/web",
    "dev:mobile": "npm run start --workspace=@kickzone/mobile",
    "mobile:android": "npm run android --workspace=@kickzone/mobile",
    "mobile:ios": "npm run ios --workspace=@kickzone/mobile",
    "mobile:web": "npm run web --workspace=@kickzone/mobile",
    "build:web": "npm run build --workspace=@kickzone/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "db:generate": "npm run db:generate --workspace=@kickzone/web",
    "db:migrate": "npm run db:migrate --workspace=@kickzone/web",
    "db:seed": "npm run db:seed --workspace=@kickzone/web",
    "db:seed:demo": "npm run db:seed:demo --workspace=@kickzone/web",
    "db:reset": "npm run db:reset --workspace=@kickzone/web",
    "jobs:work": "npm run jobs:work --workspace=@kickzone/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.69.0"
  }
}
