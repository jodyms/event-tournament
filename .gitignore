# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# Next.js
.next/

# nested checkout inside generated graph output
graphify-out/.bootstrap-template/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
apps/mobile/ios/
apps/mobile/android/

# admin uploads & local integration artifacts
apps/web/storage/uploads/*
!apps/web/storage/uploads/.gitkeep
apps/web/local-data/
